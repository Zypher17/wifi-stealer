# Protect sensitive files – no direct browser access
<FilesMatch "^(users\.json|login_throttle\.json|activity\.log|.*_wifi_creds\.log)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Prevent directory browsing
Options -Indexes

# Block direct access to credential directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^creds/ - [F,L]
</IfModule>
